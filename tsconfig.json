{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ES2023"],
		"target": "ES2023",
		"module": "Preserve",
		"moduleDetection": "force",
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Declarations are generated by tsdown via oxc, which requires explicit types on exports
		"isolatedDeclarations": true,
		"declaration": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src"]
}
